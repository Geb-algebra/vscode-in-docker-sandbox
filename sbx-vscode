#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: sbx-vscode [--no-firewall] [--] [WORKSPACE]

Options:
  --no-firewall  Allow all outbound network traffic for this sandbox.
  -h, --help     Show this help.
EOF
}

NO_FIREWALL=0
positional_args=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-firewall)
      NO_FIREWALL=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        positional_args+=("$1")
        shift
      done
      break
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      usage
      exit 2
      ;;
    *)
      positional_args+=("$1")
      ;;
  esac
  shift
done

if [ "${#positional_args[@]}" -gt 1 ]; then
  echo "Only one workspace may be specified." >&2
  usage
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workspace_arg="${positional_args[0]:-$PWD}"
WORKSPACE="${SBX_WORKSPACE:-${workspace_arg}}"

if ! command -v sbx >/dev/null 2>&1; then
  echo "sbx is required to run the VS Code sandbox." >&2
  exit 1
fi

sbx_version_json="$(sbx version --json 2>/dev/null || true)"
sbx_client_version="$(
  printf '%s\n' "${sbx_version_json}" \
    | sed -nE 's/^[[:space:]]*"version":[[:space:]]*"v?([0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' \
    | sed -n '1p'
)"
if [ -z "${sbx_client_version}" ]; then
  sbx_version_output="$(sbx version 2>&1 || true)"
  sbx_client_version="$(
    printf '%s\n' "${sbx_version_output}" \
      | sed -nE 's/^[[:space:]]*(Client Version:|sbx version:)[[:space:]]*v?([0-9]+\.[0-9]+\.[0-9]+).*/\2/p' \
      | sed -n '1p'
  )"
fi
if [ -z "${sbx_client_version}" ]; then
  echo "Unable to determine the sbx client version. Docker Sandboxes 0.43.0 or later is required." >&2
  printf 'Output from sbx version:\n%s\n' "${sbx_version_output:-${sbx_version_json}}" >&2
  exit 1
fi

IFS=. read -r sbx_version_major sbx_version_minor _ <<EOF
${sbx_client_version}
EOF
if [ "${sbx_version_major}" -eq 0 ] && [ "${sbx_version_minor}" -lt 43 ]; then
  printf 'Docker Sandboxes 0.43.0 or later is required; found %s.\n' "${sbx_client_version}" >&2
  exit 1
fi

if ! command -v ssh >/dev/null 2>&1; then
  echo "ssh is required to connect VS Code to the sandbox." >&2
  exit 1
fi

if ! command -v code >/dev/null 2>&1; then
  echo "The local code command is required to open VS Code over SSH." >&2
  exit 1
fi

if ! code --list-extensions 2>/dev/null | grep -Fxiq 'ms-vscode-remote.remote-ssh'; then
  echo "The VS Code Remote - SSH extension is required (ms-vscode-remote.remote-ssh)." >&2
  exit 1
fi

if ! ssh -G docker-sandbox-ssh-check.sbx 2>/dev/null \
  | grep -Eq '^proxycommand .*sbx.* ssh proxy '; then
  echo "Docker Sandboxes SSH access is not configured on this host." >&2
  echo "Run this once, then retry:" >&2
  echo "  sbx setup ssh" >&2
  exit 1
fi

if [ ! -d "${WORKSPACE}" ]; then
  printf 'Workspace does not exist: %s\n' "${WORKSPACE}" >&2
  exit 1
fi

WORKSPACE="$(cd "${WORKSPACE}" && pwd)"

GIT_COMMON_DIR=""
if command -v git >/dev/null 2>&1; then
  git_dir="$(git -C "${WORKSPACE}" rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"
  git_common_dir="$(git -C "${WORKSPACE}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"

  if [ -n "${git_dir}" ] && [ -d "${git_dir}" ] && [ -n "${git_common_dir}" ] && [ -d "${git_common_dir}" ]; then
    git_dir="$(cd "${git_dir}" && pwd -P)"
    git_common_dir="$(cd "${git_common_dir}" && pwd -P)"
    if [ "${git_dir}" != "${git_common_dir}" ]; then
      GIT_COMMON_DIR="${git_common_dir}"
    fi
  fi
fi

if command -v sha256sum >/dev/null 2>&1; then
  workspace_hash="$(printf '%s' "${WORKSPACE}" | sha256sum | cut -c1-8)"
elif command -v shasum >/dev/null 2>&1; then
  workspace_hash="$(printf '%s' "${WORKSPACE}" | shasum -a 256 | cut -c1-8)"
else
  echo "sha256sum or shasum is required to generate the sandbox name." >&2
  exit 1
fi

workspace_name_limit=10
sandbox_name_prefix=""
if [ "${NO_FIREWALL}" = "1" ]; then
  workspace_name_limit=7
  sandbox_name_prefix="nf-"
fi

workspace_name="$(basename "${WORKSPACE}" | sed -E 's/[^A-Za-z0-9-]+/-/g; s/^-+//; s/-+$//')"
if [ -z "${workspace_name}" ]; then
  workspace_name="workspace"
fi
workspace_name="$(printf '%s' "${workspace_name}" | cut -c "1-${workspace_name_limit}" | sed -E 's/-+$//')"

SANDBOX_NAME="${SBX_NAME:-${sandbox_name_prefix}${workspace_name}-${workspace_hash}}"
PROFILE="${SBX_PROFILE:-}"
AUTO_OPEN="${SBX_AUTO_OPEN:-1}"
SSH_HOST="${SANDBOX_NAME}.sbx"
NO_FIREWALL_KIT="${SCRIPT_DIR}/kits/no-firewall"
NETWORK_KIT="${SCRIPT_DIR}/kits/network"
export SBX_KIT_BUILDER="${SBX_KIT_BUILDER:-sandbox}"

log() {
  printf '[sbx-vscode] %s\n' "$*" >&2
}

# BEGIN TEMPORARY WORKAROUND: docker/sbx-releases#744
# sbx can deadlock while starting a layered image when the shim blocks writing
# its large "creating container task" record to the shim log FIFO. A second
# reader drains that record and lets the VM continue booting. Remove this whole
# block, plus the matching activation/cleanup block below, once the upstream
# issue is fixed in the installed sbx release.
shim_log_reader_pid=""
shim_log_marker=""
shim_log_reader_pids_file=""
shim_logs_seen_file=""

start_shim_log_fifo_workaround() {
  local shim_task_root="${HOME}/.sbx/run/d/containerd/state/io.containerd.runtime.v2.task/docker"

  shim_log_marker="$(mktemp "${TMPDIR:-/tmp}/sbx-vscode-shim-log.XXXXXX")"
  shim_log_reader_pids_file="$(mktemp "${TMPDIR:-/tmp}/sbx-vscode-shim-log-pids.XXXXXX")"
  shim_logs_seen_file="$(mktemp "${TMPDIR:-/tmp}/sbx-vscode-shim-logs-seen.XXXXXX")"
  (
    while :; do
      for shim_log in "${shim_task_root}"/*/log; do
        [ -p "${shim_log}" ] || continue
        [ "${shim_log}" -nt "${shim_log_marker}" ] || continue
        grep -Fqx "${shim_log}" "${shim_logs_seen_file}" && continue
        printf '%s\n' "${shim_log}" >>"${shim_logs_seen_file}"
        cat "${shim_log}" >/dev/null &
        printf '%s\n' "$!" >>"${shim_log_reader_pids_file}"
      done
      sleep 0.05
    done
  ) &
  shim_log_reader_pid="$!"
}

stop_shim_log_fifo_workaround() {
  local reader_pid

  if [ -n "${shim_log_reader_pid}" ]; then
    kill "${shim_log_reader_pid}" 2>/dev/null || true
    wait "${shim_log_reader_pid}" 2>/dev/null || true
    shim_log_reader_pid=""
  fi
  if [ -n "${shim_log_reader_pids_file}" ] && [ -f "${shim_log_reader_pids_file}" ]; then
    while IFS= read -r reader_pid; do
      kill "${reader_pid}" 2>/dev/null || true
      wait "${reader_pid}" 2>/dev/null || true
    done <"${shim_log_reader_pids_file}"
    rm -f "${shim_log_reader_pids_file}"
    shim_log_reader_pids_file=""
  fi
  if [ -n "${shim_logs_seen_file}" ]; then
    rm -f "${shim_logs_seen_file}"
    shim_logs_seen_file=""
  fi
  if [ -n "${shim_log_marker}" ]; then
    rm -f "${shim_log_marker}"
    shim_log_marker=""
  fi
}
# END TEMPORARY WORKAROUND: docker/sbx-releases#744

if [ "${NO_FIREWALL}" = "1" ]; then
  log "WARNING: all outbound network traffic is allowed for ${SANDBOX_NAME}"
  log "organization governance and sandbox profile deny rules still take precedence"
fi

if [ -n "${GIT_COMMON_DIR}" ]; then
  log "linked worktree detected: ${WORKSPACE}"
  log "shared Git directory (read-write mount): ${GIT_COMMON_DIR}"
fi

# BEGIN TEMPORARY WORKAROUND ACTIVATION: docker/sbx-releases#744
# Keep the FIFO reader active through both creation and the SSH-triggered start
# of an existing stopped sandbox.
start_shim_log_fifo_workaround
trap 'stop_shim_log_fifo_workaround' EXIT
trap 'stop_shim_log_fifo_workaround; exit 130' INT TERM
# END TEMPORARY WORKAROUND ACTIVATION: docker/sbx-releases#744

if sbx ls -q | grep -Fqx "${SANDBOX_NAME}"; then
  log "reusing sandbox: ${SANDBOX_NAME}"
else
  create_args=(create --name "${SANDBOX_NAME}" --skills=readonly --kit "${NETWORK_KIT}")
  if [ "${NO_FIREWALL}" = "1" ]; then
    create_args+=(--kit "${NO_FIREWALL_KIT}")
  fi
  if [ -n "${PROFILE}" ]; then
    create_args+=(--profile "${PROFILE}")
  fi
  create_args+=("${SCRIPT_DIR}" "${WORKSPACE}")
  if [ -n "${GIT_COMMON_DIR}" ]; then
    create_args+=("${GIT_COMMON_DIR}")
  fi

  log "creating Codex sandbox: ${SANDBOX_NAME}"
  log "workload Kit: ${SCRIPT_DIR}"
  log "workspace: ${WORKSPACE}"
  log "Codex authentication must be configured on the host with:"
  log "  sbx secret set -g openai --oauth"
  sbx "${create_args[@]}"
fi

ssh_ready=0
for _ in $(seq 1 30); do
  if ssh -o BatchMode=yes -o ConnectTimeout=1 "${SSH_HOST}" true >/dev/null 2>&1; then
    ssh_ready=1
    break
  fi
  sleep 1
done
if [ "${ssh_ready}" != "1" ]; then
  log "Docker Sandboxes SSH access did not become ready: ${SSH_HOST}"
  log "ensure Docker Sandboxes 0.43.0 or later is installed and run:"
  log "  sbx setup ssh"
  exit 1
fi

REMOTE_AUTHORITY="ssh-remote+${SSH_HOST}"
REMOTE_FOLDER_URI="vscode-remote://${REMOTE_AUTHORITY}${WORKSPACE}"

log "sandbox SSH target: ${SSH_HOST}"
log "connect from the host with:"
printf '[sbx-vscode]   ssh %q\n' "${SSH_HOST}" >&2
log "open the mounted workspace in VS Code with:"
printf '[sbx-vscode]   code --new-window --folder-uri %q\n' "${REMOTE_FOLDER_URI}" >&2

if [ "${AUTO_OPEN}" != "0" ]; then
  log "opening the workspace in local VS Code over SSH"
  code --new-window --folder-uri "${REMOTE_FOLDER_URI}"
fi

# BEGIN TEMPORARY WORKAROUND CLEANUP: docker/sbx-releases#744
# Do this after launching VS Code: a stuck FIFO reader must not prevent the
# mounted workspace from opening automatically.
stop_shim_log_fifo_workaround
trap - EXIT INT TERM
# END TEMPORARY WORKAROUND CLEANUP: docker/sbx-releases#744

log "launcher finished; the sandbox remains available"
log "stop it when finished with:"
printf '[sbx-vscode]   sbx stop %q\n' "${SANDBOX_NAME}" >&2
