#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: sbx-vscode [--no-firewall] [--] [WORKSPACE]

Options:
  --no-firewall  Allow all outbound network traffic for this sandbox.
  -h, --help     Show this help.
EOF
}

NO_FIREWALL=0
positional_args=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-firewall)
      NO_FIREWALL=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        positional_args+=("$1")
        shift
      done
      break
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      usage
      exit 2
      ;;
    *)
      positional_args+=("$1")
      ;;
  esac
  shift
done

if [ "${#positional_args[@]}" -gt 1 ]; then
  echo "Only one workspace may be specified." >&2
  usage
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workspace_arg="${positional_args[0]:-$PWD}"
WORKSPACE="${SBX_WORKSPACE:-${workspace_arg}}"

if ! command -v sbx >/dev/null 2>&1; then
  echo "sbx is required to run the VS Code sandbox." >&2
  exit 1
fi

sbx_version_output="$(sbx version 2>&1 || true)"
sbx_client_version="$(
  printf '%s\n' "${sbx_version_output}" \
    | sed -nE 's/^(Client Version:|sbx version:)[[:space:]]*v?([0-9]+\.[0-9]+\.[0-9]+).*/\2/p' \
    | sed -n '1p'
)"
if [ -z "${sbx_client_version}" ]; then
  echo "Unable to determine the sbx client version. Docker Sandboxes 0.43.0 or later is required." >&2
  exit 1
fi

IFS=. read -r sbx_version_major sbx_version_minor _ <<EOF
${sbx_client_version}
EOF
if [ "${sbx_version_major}" -eq 0 ] && [ "${sbx_version_minor}" -lt 43 ]; then
  printf 'Docker Sandboxes 0.43.0 or later is required; found %s.\n' "${sbx_client_version}" >&2
  exit 1
fi

if ! command -v ssh >/dev/null 2>&1; then
  echo "ssh is required to connect VS Code to the sandbox." >&2
  exit 1
fi

if ! command -v code >/dev/null 2>&1; then
  echo "The local code command is required to open VS Code over SSH." >&2
  exit 1
fi

if ! code --list-extensions 2>/dev/null | grep -Fxiq 'ms-vscode-remote.remote-ssh'; then
  echo "The VS Code Remote - SSH extension is required (ms-vscode-remote.remote-ssh)." >&2
  exit 1
fi

if ! ssh -G docker-sandbox-ssh-check.sbx 2>/dev/null \
  | grep -Eq '^proxycommand .*sbx.* ssh proxy '; then
  echo "Docker Sandboxes SSH access is not configured on this host." >&2
  echo "Run this once, then retry:" >&2
  echo "  sbx setup ssh" >&2
  exit 1
fi

if [ ! -d "${WORKSPACE}" ]; then
  printf 'Workspace does not exist: %s\n' "${WORKSPACE}" >&2
  exit 1
fi

WORKSPACE="$(cd "${WORKSPACE}" && pwd)"

GIT_COMMON_DIR=""
if command -v git >/dev/null 2>&1; then
  git_dir="$(git -C "${WORKSPACE}" rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"
  git_common_dir="$(git -C "${WORKSPACE}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"

  if [ -n "${git_dir}" ] && [ -d "${git_dir}" ] && [ -n "${git_common_dir}" ] && [ -d "${git_common_dir}" ]; then
    git_dir="$(cd "${git_dir}" && pwd -P)"
    git_common_dir="$(cd "${git_common_dir}" && pwd -P)"
    if [ "${git_dir}" != "${git_common_dir}" ]; then
      GIT_COMMON_DIR="${git_common_dir}"
    fi
  fi
fi

if command -v sha256sum >/dev/null 2>&1; then
  workspace_hash="$(printf '%s' "${WORKSPACE}" | sha256sum | cut -c1-8)"
elif command -v shasum >/dev/null 2>&1; then
  workspace_hash="$(printf '%s' "${WORKSPACE}" | shasum -a 256 | cut -c1-8)"
else
  echo "sha256sum or shasum is required to generate the sandbox name." >&2
  exit 1
fi

workspace_name_limit=10
sandbox_name_prefix=""
if [ "${NO_FIREWALL}" = "1" ]; then
  workspace_name_limit=7
  sandbox_name_prefix="nf-"
fi

workspace_name="$(basename "${WORKSPACE}" | sed -E 's/[^A-Za-z0-9-]+/-/g; s/^-+//; s/-+$//')"
if [ -z "${workspace_name}" ]; then
  workspace_name="workspace"
fi
workspace_name="$(printf '%s' "${workspace_name}" | cut -c "1-${workspace_name_limit}" | sed -E 's/-+$//')"

SANDBOX_NAME="${SBX_NAME:-${sandbox_name_prefix}${workspace_name}-${workspace_hash}}"
PROFILE="${SBX_PROFILE:-}"
AUTO_OPEN="${SBX_AUTO_OPEN:-1}"
SSH_HOST="${SANDBOX_NAME}.sbx"
NO_FIREWALL_KIT="${SCRIPT_DIR}/kits/no-firewall"

case "$(uname -m)" in
  arm64|aarch64) artifact_arch="arm64" ;;
  x86_64|amd64) artifact_arch="amd64" ;;
  *)
    printf 'Unsupported host architecture: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac
artifact_dir="${SCRIPT_DIR}/artifacts"
artifact_name="toolchain-linux-${artifact_arch}.tar.zst"
artifact_path="${artifact_dir}/${artifact_name}"
checksum_path="${artifact_path}.sha256"
artifact_path_file="${SCRIPT_DIR}/files/home/.local/share/vscode-in-sandbox/artifact-path"

# BEGIN TEMPORARY WORKAROUND: docker/sbx-releases#366
# An empty default lets sbx select its built-in codex-docker template. Custom
# template layers are currently unreliable on sbx 0.37.x, so a marker-guarded
# Kit startup hook installs tools once per sandbox instead. See:
# docs/temporary-sbx-0.37-template-layer-workaround.md
TEMPLATE_NAME="${SBX_TEMPLATE_NAME:-}"
# END TEMPORARY WORKAROUND: docker/sbx-releases#366

log() {
  printf '[sbx-vscode] %s\n' "$*" >&2
}

if [ "${NO_FIREWALL}" = "1" ]; then
  log "WARNING: all outbound network traffic is allowed for ${SANDBOX_NAME}"
  log "organization governance and sandbox profile deny rules still take precedence"
fi

if [ -n "${GIT_COMMON_DIR}" ]; then
  log "linked worktree detected: ${WORKSPACE}"
  log "shared Git directory (read-write mount): ${GIT_COMMON_DIR}"
fi

if sbx ls -q | grep -Fqx "${SANDBOX_NAME}"; then
  log "reusing sandbox: ${SANDBOX_NAME}"
else
  if [ ! -r "${artifact_path}" ] || [ ! -r "${checksum_path}" ] \
    || [ "$(sed -n '1p' "${artifact_path_file}" 2>/dev/null || true)" != "${artifact_dir}" ]; then
    log "prebuilt toolchain artifact is missing for ${artifact_arch}"
    log "generate it before creating a sandbox:"
    printf '[sbx-vscode]   %q\n' "${SCRIPT_DIR}/build-toolchain-artifact.sh" >&2
    exit 1
  fi
  expected_hash="$(awk 'NR == 1 { print $1 }' "${checksum_path}")"
  if command -v sha256sum >/dev/null 2>&1; then
    actual_hash="$(sha256sum "${artifact_path}" | awk '{print $1}')"
  else
    actual_hash="$(shasum -a 256 "${artifact_path}" | awk '{print $1}')"
  fi
  if ! printf '%s' "${expected_hash}" | grep -Eq '^[0-9a-f]{64}$' \
    || [ "${actual_hash}" != "${expected_hash}" ]; then
    log "prebuilt toolchain artifact checksum mismatch: ${artifact_name}"
    log "regenerate it with ${SCRIPT_DIR}/build-toolchain-artifact.sh"
    exit 1
  fi

  create_args=(create --name "${SANDBOX_NAME}" --skills=readonly --kit "${SCRIPT_DIR}")
  if [ "${NO_FIREWALL}" = "1" ]; then
    create_args+=(--kit "${NO_FIREWALL_KIT}")
  fi
  if [ -n "${TEMPLATE_NAME}" ]; then
    create_args+=(--template "${TEMPLATE_NAME}")
  fi
  if [ -n "${PROFILE}" ]; then
    create_args+=(--profile "${PROFILE}")
  fi
  create_args+=(codex "${WORKSPACE}")
  create_args+=("${artifact_dir}")
  if [ -n "${GIT_COMMON_DIR}" ]; then
    create_args+=("${GIT_COMMON_DIR}")
  fi

  log "creating Codex sandbox: ${SANDBOX_NAME}"
  if [ -n "${TEMPLATE_NAME}" ]; then
    log "template override: ${TEMPLATE_NAME}"
  else
    log "template: built-in codex-docker"
  fi
  log "workspace: ${WORKSPACE}"
  log "the Kit extracts the prebuilt toolchain during sandbox creation"
  log "Codex authentication must be configured on the host with:"
  log "  sbx secret set -g openai --oauth"
  sbx "${create_args[@]}"
fi

ssh_ready=0
for _ in $(seq 1 30); do
  if ssh -o BatchMode=yes -o ConnectTimeout=1 "${SSH_HOST}" true >/dev/null 2>&1; then
    ssh_ready=1
    break
  fi
  sleep 1
done
if [ "${ssh_ready}" != "1" ]; then
  log "Docker Sandboxes SSH access did not become ready: ${SSH_HOST}"
  log "ensure Docker Sandboxes 0.37.0 or later is installed and run:"
  log "  sbx setup ssh"
  exit 1
fi

# BEGIN TEMPORARY WORKAROUND: docker/sbx-releases#366
# The startup hook can run concurrently with container startup. Wait for its
# persistent result before opening VS Code. Remove this block with the matching
# spec.yaml workaround after following the workaround memo.
toolchain_ready="/home/agent/.local/state/vscode-in-sandbox/toolchain.ready"
toolchain_failed="/home/agent/.local/state/vscode-in-sandbox/toolchain.failed"
toolchain_script="/home/agent/.local/share/vscode-in-sandbox/install-toolchain-once.sh"
toolchain_state=""

for toolchain_wait_seconds in $(seq 0 900); do
  toolchain_state="$(
    ssh -o BatchMode=yes "${SSH_HOST}" "
      if [ -f '${toolchain_ready}' ]; then
        printf ready
      elif [ -f '${toolchain_failed}' ]; then
        printf failed
      elif [ ! -f '${toolchain_script}' ]; then
        printf unavailable
      else
        printf installing
      fi
    " 2>/dev/null || true
  )"

  case "${toolchain_state}" in
    ready)
      break
      ;;
    failed)
      log "sandbox toolchain installation failed"
      ssh -o BatchMode=yes "${SSH_HOST}" \
        "cat '${toolchain_failed}'; tail -100 /home/agent/.local/state/vscode-in-sandbox/toolchain-install.log" >&2 || true
      exit 1
      ;;
    unavailable)
      log "this existing sandbox was not created with the current Kit"
      log "remove and recreate it:"
      printf '[sbx-vscode]   sbx rm %q\n' "${SANDBOX_NAME}" >&2
      exit 1
      ;;
    installing)
      if [ $((toolchain_wait_seconds % 10)) -eq 0 ]; then
        log "waiting for sandbox toolchain installation (${toolchain_wait_seconds}s)"
      fi
      sleep 1
      ;;
    *)
      printf 'Unexpected toolchain installation state: %s\n' "${toolchain_state}" >&2
      exit 1
      ;;
  esac
done

if [ "${toolchain_state}" != "ready" ]; then
  log "timed out waiting for sandbox toolchain installation"
  ssh -o BatchMode=yes "${SSH_HOST}" \
    "tail -100 /home/agent/.local/state/vscode-in-sandbox/toolchain-install.log" >&2 || true
  exit 1
fi
# END TEMPORARY WORKAROUND: docker/sbx-releases#366

REMOTE_AUTHORITY="ssh-remote+${SSH_HOST}"

log "sandbox SSH target: ${SSH_HOST}"
log "connect from the host with:"
printf '[sbx-vscode]   ssh %q\n' "${SSH_HOST}" >&2
log "open the mounted workspace in VS Code with:"
printf '[sbx-vscode]   code --new-window --remote %q %q\n' "${REMOTE_AUTHORITY}" "${WORKSPACE}" >&2

if [ "${AUTO_OPEN}" != "0" ]; then
  log "opening the workspace in local VS Code over SSH"
  code --new-window --remote "${REMOTE_AUTHORITY}" "${WORKSPACE}"

  # Install the kit's common extensions into the Remote-SSH server after it
  # has been bootstrapped. The image intentionally does not contain the VS
  # Code desktop/server package, so this is best-effort and must not prevent
  # the workspace from opening if a particular extension is unavailable.
  extensions_file="${SCRIPT_DIR}/files/home/.config/vscode-in-sandbox/extensions.txt"
  if [ -f "${extensions_file}" ]; then
    while IFS= read -r extension_id; do
      case "${extension_id}" in
        ''|'#'*) continue ;;
      esac
      log "installing Remote-SSH extension ${extension_id}"
      code --remote "${REMOTE_AUTHORITY}" --install-extension "${extension_id}" --force \
        >/dev/null 2>&1 || log "warning: failed to install Remote-SSH extension ${extension_id}"
    done < "${extensions_file}"
  fi
fi

log "launcher finished; the sandbox remains available"
log "stop it when finished with:"
printf '[sbx-vscode]   sbx stop %q\n' "${SANDBOX_NAME}" >&2
